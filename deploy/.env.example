# Copy to /opt/xpanel-central/.env only when deploying manually.
# install-docker.sh generates these values automatically on first install.
XPANEL_ADMIN_USER=admin
XPANEL_ADMIN_PASSWORD=replace-with-a-long-random-password
XPANEL_AGENT_REGISTRATION_TOKEN=replace-with-a-separate-random-bootstrap-token
XPANEL_CORS_ORIGINS=http://localhost:18080,http://127.0.0.1:18080
XPANEL_PUBLIC_PORT=18080
XPANEL_BIND_ADDRESS=127.0.0.1
